# ============================================================
# AI 漫剧管线 · 配置模板
#
# 用法：
#   1. 复制本文件为 .env
#   2. 填入你的 API Key
#   3. 按需修改其他项
#
# 改完要重启服务才生效
# ============================================================


# ------------------------------------------------------------
# 一、必须填的 API Key
# ------------------------------------------------------------

# 火山方舟（出图 + 出视频）
# 申请：https://console.volcengine.com/ark
# 注意：需要在控制台「开通管理」里开通模型，且账户余额 ≥ 200 元
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包语音合成（配音）
# 申请：https://console.volcengine.com/speech
# 格式是 UUID，不是 ark- 开头
VOLC_TTS_TOKEN=

# 大模型（写剧本）
# 申请：https://platform.deepseek.com
# 也可以用 Kimi / 通义，改 LLM_BASE_URL 即可（OpenAI 兼容）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat


# ------------------------------------------------------------
# 二、模型选择
# ------------------------------------------------------------

# 出图（Seedream）
DOUBAO_IMAGE_MODEL=doubao-seedream-5-5-261028
DOUBAO_IMAGE_SIZE=1080x1920
DOUBAO_IMAGE_PRICE=0.20
DOUBAO_WATERMARK=off

# 出视频（Seedance）
# 可选：doubao-seedance-2-5-flash-261115（约 ¥1.0/秒，推荐）
#       doubao-seedance-2-0-mini-260615（更便宜）
JIMENG_MODEL=doubao-seedance-2-5-flash-261115
JIMENG_RESOLUTION=720p
JIMENG_DURATION=4
JIMENG_AUDIO=off

# 配音音色
VOLC_TTS_VOICE=zh_female_tianmeixiaoyuan_uranus_bigtts
TTS_VOICE_WANBAI=zh_female_tianmeixiaoyuan_uranus_bigtts
TTS_VOICE_LINYUE=zh_male_qingshuangnanda_uranus_bigtts
TTS_VOICE_NARRATOR=zh_male_yuanboxiaoshu_uranus_bigtts


# ------------------------------------------------------------
# 三、引擎（决定每环节用哪个插件）
# ------------------------------------------------------------

SCRIPT_PROVIDER=deepseek
IMAGE_PROVIDER=doubao
VIDEO_PROVIDER=jimeng
TTS_PROVIDER=ark
BGM_PROVIDER=synth
EDIT_PROVIDER=rhythm
LOG_PROVIDER=excel
SCENE3D_PROVIDER=blender
RADIO_PROVIDER=simple


# ------------------------------------------------------------
# 四、画风
# ------------------------------------------------------------

# 所有出图自动拼接这段描述。留空 = 用模型默认画风
# 也可以在 Web「设置 → 画风」里改（有预设按钮）
IMAGE_STYLE_SUFFIX=中国水墨画风格，宣纸质感，水墨笔触明显，写意留白，低饱和浅灰调


# ------------------------------------------------------------
# 五、本地出图（可选，不用 ComfyUI 就留空）
# ------------------------------------------------------------

COMFY_HOST=http://127.0.0.1:8188
COMFY_WORKFLOW=

# 出图重试与质检
IMAGE_MAX_RETRY=12
IMAGE_QUALITY_MIN_VAR=600


# ------------------------------------------------------------
# 六、3D（可选）
# ------------------------------------------------------------

# Blender 可执行文件路径
# 留空会自动搜索：PATH / C:\Program Files\Blender* / D:\Blender* / _tools/blender/
BLENDER_EXE=


# ------------------------------------------------------------
# 七、视频输出
# ------------------------------------------------------------

VIDEO_FPS=30
USE_NVENC=1
ZOOM_SPEED=0.0008
OUTPUT_RESOLUTION=1080p


# ------------------------------------------------------------
# 八、通知（可选）
# ------------------------------------------------------------

# 飞书机器人 webhook（任务完成/告警推送到群）
FEISHU_WEBHOOK=
FEISHU_SECRET=
FEISHU_KEYWORD=


# ------------------------------------------------------------
# 九、定时批处理（可选）
# ------------------------------------------------------------

BATCH_HOUR=0
BATCH_MINUTE=30


# ------------------------------------------------------------
# 十、成本与预算
# ------------------------------------------------------------

SCRIPT_BUDGET=5
IMAGE_BUDGET=50
TTS_BUDGET=10
VIDEO_BUDGET_MAX=200
COST_ALERT=300


# ------------------------------------------------------------
# 十一、其他
# ------------------------------------------------------------

# 严格模式：失败就停（true）还是降级继续（false）
STRICT_MODE=false
AUTO_FALLBACK=true

# 单个项目磁盘上限（MB）
PROJECT_DISK_MAX_MB=5000

# 记忆库最大字符数
MEMORY_MAX_CHARS=8000
